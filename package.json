{
  "name": "mydegreeplan",
  "productName": "MyDegreePlan",
  "version": "0.1.0",
  "description": "MyDegreePlan as a desktop app: the web build, hosted in a locked-down Electron window.",
  "author": "MyDegreePlan team",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --mdp-smoke",
    "test": "node --test test/*.test.js",
    "prepare:web": "node scripts/prepare-web.js",
    "pack": "npm run prepare:web && electron-builder --win --dir --publish never",
    "dist": "npm run prepare:web && electron-builder --win --publish never",
    "icons": "electron scripts/make-icons.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  }
}
